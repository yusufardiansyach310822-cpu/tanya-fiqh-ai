# Salin file ini menjadi ".env" lalu isi nilainya. JANGAN pernah upload .env ke GitHub.

# API key GRATIS dari https://aistudio.google.com/apikey
GEMINI_API_KEY=isi-api-key-gemini-anda-di-sini

# Model Gemini. Cek daftar dan batas gratis terbaru di Google AI Studio.
MODEL=gemini-2.5-flash

PORT=3000

# Batas pertanyaan AI per IP dalam satu jendela waktu
RATE_LIMIT=10
RATE_WINDOW_MIN=60

# Batas total pertanyaan AI per hari. Sesuaikan dengan kuota gratis proyek Anda.
DAILY_CAP=200
